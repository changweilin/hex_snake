{
  "name": "hex-snake",
  "version": "1.0.0",
  "private": true,
  "description": "A hex-grid snake game with virtual joystick and AWEFXZ controls.",
  "scripts": {
    "dev": "node server.js",
    "build": "node build.js",
    "build:web": "node build.js",
    "build:pwa": "node build.js --pwa",
    "build:mobile": "node build.js --mobile",
    "start": "node server.js --dist",
    "simulate": "node tools/simulate-balance.js",
    "simulate:scheduled": "node tools/sim-scheduler.js start",
    "simulate:run": "node tools/sim-scheduler.js run",
    "simulate:jobs": "node tools/sim-scheduler.js list",
    "tune:balance": "node tools/tune-balance.js",
    "tune:lobster-palm-draw": "node tools/tune-lobster-palm-draw.js",
    "tune:ai-strategy": "node tools/tune-ai-strategy.js",
    "evaluate:basic-gate": "node tools/evaluate-basic-gate.js",
    "evaluate:strategy-gate": "node tools/evaluate-target-strategy-gate.js",
    "reset:high-ai-basic": "node tools/reset-high-ai-basic.js",
    "apply:ai-strategy": "node tools/apply-ai-strategy.js",
    "simulate:ai-cross": "node tools/run-ai-cross-play.js",
    "optimize:strategy": "node tools/run-strategy-optimization.js",
    "test:smoke": "node tools/smoke-test.js",
    "test:network": "node tools/network-room-routing-test.js",
    "test:module-loader": "node tools/module-loader-smoke-test.js",
    "test:mobile": "node tools/mobile-smoke-test.js",
    "test:mobile-platform": "node tools/mobile-platform-adapter-test.js",
    "test:offline": "node tools/offline-smoke-test.js",
    "audit:esm-map": "node tools/audit-esm-export-map.js",
    "audit:globals": "node tools/audit-legacy-globals.js",
    "audit:state-boundary": "node tools/audit-state-boundary.js",
    "check:assets": "node tools/check-assets.js",
    "check:size": "node tools/check-dist-size.js",
    "app:check": "node tools/check-app-readiness.js",
    "store:check": "node tools/check-store-readiness.js",
    "cap:copy": "npm run build:mobile && npx cap copy",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "android:build:debug": "npm run cap:sync && node tools/build-android-artifact.js --type=apk --variant=debug",
    "android:bundle:debug": "npm run cap:sync && node tools/build-android-artifact.js --type=bundle --variant=debug",
    "android:bundle:release": "npm run cap:sync && node tools/build-android-artifact.js --type=bundle --variant=release",
    "android:bundle:signed": "npm run cap:sync && node tools/build-android-artifact.js --type=bundle --variant=release --require-signing",
    "release:check": "node tools/run-release-check.js",
    "reports:dashboard": "node tools/build-report-dashboard.js",
    "reports:dashboard:serve": "node tools/report-dashboard-server.js",
    "generate:sfx": "node tools/generate-character-sfx.js",
    "characters:show": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/show-characters.ps1",
    "data:check": "node tools/check-utf8-json.js",
    "text:check": "node tools/check-text-encoding.js",
    "test": "node tools/run-tests.js",
    "test:quick": "node tools/run-tests.js --quick"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "playwright": "^1.44.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1"
  }
}
